# =============================================================================
# eloEscola — variáveis de ambiente
# =============================================================================
# Copie para `.env` (NUNCA versione o `.env`) e preencha.
#
# Convenção usada em todo o projeto:
#   [OBRIGATÓRIO]  sem isso o recurso correspondente não funciona
#   [PRODUÇÃO]     obrigatório apenas com NODE_ENV=production
#   [OPCIONAL]     se ausente, o recurso fica desativado de forma explícita
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# URL pública do app (usada em links de recuperação de senha e retorno de pagamento)
PUBLIC_APP_URL=https://app.eloescola.com.br
# Base para o Checkout do provedor de pagamentos
BILLING_PUBLIC_BASE_URL=https://app.eloescola.com.br

# -----------------------------------------------------------------------------
# Segurança  [PRODUÇÃO: OBRIGATÓRIO]
# -----------------------------------------------------------------------------
# Chave HMAC das sessões. NUNCA reutilize a de desenvolvimento.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Sem valor (ou < 32 chars) em produção o servidor NÃO emite nem aceita sessão.
SESSION_SECRET=

# E-mails com acesso ao painel Master (separa por vírgula). Sem isso o painel
# Master responde 503 — ele nunca fica aberto por omissão.
PLATFORM_OWNER_EMAILS=

# Origens com permissão de CORS (separadas por vírgula). Sem valor, o app só
# aceita same-origin.
ALLOWED_ORIGINS=https://app.eloescola.com.br

# Rate limits (ajuste conforme o tráfego real)
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT=20
AI_RATE_LIMIT=12
PUBLIC_WRITE_RATE_LIMIT=30
TRUST_PROXY=1
TRUST_PROXY_HOPS=1

# -----------------------------------------------------------------------------
# Bancos de dados
# -----------------------------------------------------------------------------
# Conexão Postgres direta (Drizzle/fallback do backend legado)
SUPABASE_DB_URL=
# OU
DATABASE_URL=

# Supabase (cliente e backend)
SUPABASE_URL=https://jaoheenjltzzglfncgfq.supabase.co
# Chave publicável: pode ir ao navegador (com RLS fechada)
SUPABASE_PUBLISHABLE_KEY=
# Chave SECRETA: só no servidor. Necessária para o núcleo SaaS, painéis,
# cobrança, storage privado e autenticação por hash. NUNCA exponha no frontend.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://jaoheenjltzzglfncgfq.supabase.co/auth/v1/.well-known/jwks.json

# -----------------------------------------------------------------------------
# Primeiro administrador  [usar uma vez e remover]
# -----------------------------------------------------------------------------
# Sem estas variáveis o sistema NÃO cria nenhuma conta padrão.
# Depois do primeiro acesso, remova ambas.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_INSTITUTION=eloEscola

# -----------------------------------------------------------------------------
# E-mail transacional (Resend)  [OPCIONAL]
# -----------------------------------------------------------------------------
# Sem RESEND_API_KEY + TRANSACTIONAL_EMAIL_FROM a recuperação de senha por
# e-mail grava o token mas informa "deliveryPending: true" — não finge envio.
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=eloEscola <nao-responda@eloescola.com.br>

# -----------------------------------------------------------------------------
# SMS (Twilio)  [OPCIONAL]
# -----------------------------------------------------------------------------
# Sem estas variáveis a recuperação por SMS fica indisponível.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# Pagamentos  [OPCIONAL — ausência = modo sandbox]
# -----------------------------------------------------------------------------
# Com STRIPE_SECRET_KEY presente, as cobranças reais são emitidas.
# Sem ela, tudo funciona em sandbox: cobrança registrada como PENDENTE e nunca
# marcada como paga automaticamente.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Alternativas (ainda não implementadas no código — ver RELATORIO_IMPLEMENTACAO)
ASAAS_API_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Segredo genérico para webhooks de outros provedores
BILLING_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Inteligência artificial (Gemini)  [OPCIONAL]
# -----------------------------------------------------------------------------
# Só no servidor. Sem a chave, o assistente responde com o fallback local e
# NÃO consome cota da instituição.
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Frontend (build Vite) — variáveis prefixadas com VITE_ vão para o bundle.
# Só coloque aqui valores públicos.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://jaoheenjltzzglfncgfq.supabase.co
VITE_SUPABASE_ANON_KEY=
# E-mails do proprietário para EXIBIR o botão do painel Master.
# A autorização real é feita no servidor com PLATFORM_OWNER_EMAILS.
VITE_PLATFORM_OWNER_EMAILS=
